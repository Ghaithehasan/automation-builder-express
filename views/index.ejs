<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>FlowForge — Automation Builder</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/style.css" />
	</head>
	<body>
		<!-- ═══ HEADER ═══ -->
		<header class="app-header">
			<div class="header-brand">
				<div class="header-logo">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none">
						<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" fill="currentColor" />
					</svg>
				</div>
				<span class="header-title">FlowForge</span>
				<span class="header-badge">Automation Builder</span>
			</div>

			<div class="header-center">
				<div class="workflow-name-wrapper">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
						<path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
					</svg>
					<input id="workflow-name" type="text" placeholder="Untitled Workflow" class="workflow-name-input" />
				</div>
			</div>

			<div class="header-actions">
				<button id="load-latest-workflow" class="btn btn-ghost" title="Load latest saved workflow">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
						<polyline points="7,10 12,15 17,10" />
						<line x1="12" y1="15" x2="12" y2="3" />
					</svg>
					Load
				</button>
				<button id="save-workflow" class="btn btn-secondary" title="Save workflow">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
						<polyline points="17,21 17,13 7,13 7,21" />
						<polyline points="7,3 7,8 15,8" />
					</svg>
					Save
				</button>
				<button id="run-workflow" class="btn btn-primary" title="Execute workflow">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<polygon points="5,3 19,12 5,21" />
					</svg>
					Run Workflow
				</button>
			</div>
		</header>

		<!-- ═══ MAIN LAYOUT ═══ -->
		<div class="app-layout">

			<!-- LEFT: Node Palette -->
			<aside class="sidebar">
				<div class="sidebar-header">
					<div class="panel-label">
						<span class="label-dot"></span>
						Node Palette
					</div>
					<span class="sidebar-hint">Drag to canvas</span>
				</div>
				<div id="node-types-list" class="node-types-list"></div>

				<div class="sidebar-footer">
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10" />
						<line x1="12" y1="8" x2="12" y2="12" />
						<line x1="12" y1="16" x2="12.01" y2="16" />
					</svg>
					Nodes execute top → bottom
				</div>
			</aside>

			<!-- CENTER: Canvas -->
			<main class="canvas-area">
				<div class="canvas-toolbar">
					<div class="canvas-label">
						<span class="label-dot dot-blue"></span>
						Canvas
					</div>
					<div class="canvas-stats" id="canvas-stats">0 nodes</div>
				</div>

				<div id="workspace" class="workspace">
					<!-- nodes rendered by JS -->
				</div>
			</main>

			<!-- RIGHT: Output + Debug -->
			<aside class="right-panel">

				<!-- Output Section -->
				<div class="output-section">
					<div class="panel-label-row">
						<div class="panel-label">
							<span class="label-dot dot-green"></span>
							Execution Output
						</div>
						<button class="btn-icon" id="clear-output" title="Clear output">
							<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
								<polyline points="3,6 5,6 21,6" /><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
								<path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" />
							</svg>
						</button>
					</div>

					<div id="workflow-output" class="workflow-output">
						<div class="output-placeholder">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<polygon points="5,3 19,12 5,21" />
							</svg>
							<span>Run workflow to see results</span>
						</div>
					</div>

					<div id="save-status" class="save-status"></div>
				</div>

				<!-- Agent Chat -->
				<div class="chat-section">
					<div class="panel-label-row">
						<div class="panel-label">
							<span class="label-dot dot-blue"></span>
							Agent Chat
						</div>
					</div>

					<div id="chat-messages" class="chat-messages">
						<div class="chat-placeholder">Ask the agent to run or save workflows.</div>
					</div>

					<div class="chat-input-row">
						<textarea id="chat-input" class="chat-input" placeholder="Type a message..." rows="2"></textarea>
						<button id="chat-send" class="btn btn-secondary" type="button">Send</button>
					</div>

					<div id="chat-status" class="chat-status"></div>
				</div>

				<!-- Debug / Node Tester -->
				<div class="debug-section" id="debug-section">
					<div class="panel-label-row collapsible" onclick="document.getElementById('debug-section').classList.toggle('collapsed')">
						<div class="panel-label">
							<span class="label-dot dot-yellow"></span>
							Node Tester
						</div>
						<svg class="collapse-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<polyline points="6,9 12,15 18,9" />
						</svg>
					</div>

					<div class="debug-body">
						<!-- Log Node Tester -->
						<div class="debug-panel">
							<div class="debug-panel-title">
								<span class="debug-type-badge">log</span>
								Log Node
							</div>
							<textarea id="log-message" class="debug-input" placeholder="Enter message..." rows="2"></textarea>
							<button id="run-log-node" class="btn btn-debug">
								<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<polygon points="5,3 19,12 5,21" />
								</svg>
								Run
							</button>
							<div id="execution-output" class="execution-output"></div>
						</div>

						<!-- Color Node Tester -->
						<div class="debug-panel">
							<div class="debug-panel-title">
								<span class="debug-type-badge badge-color">color</span>
								Color Node
							</div>
							<textarea id="color-message" class="debug-input" placeholder="Enter message..." rows="2"></textarea>
							<select id="color-select" class="debug-select">
								<option value="">Select a color</option>
								<option value="red">red</option>
								<option value="blue">blue</option>
								<option value="green">green</option>
								<option value="orange">orange</option>
								<option value="purple">purple</option>
							</select>
							<button id="run-color-node" class="btn btn-debug">
								<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<polygon points="5,3 19,12 5,21" />
								</svg>
								Run
							</button>
							<div id="color-execution-output" class="execution-output"></div>
						</div>
					</div>
				</div>

			</aside>
		</div>

		<script src="/app.js"></script>
		<script>
			// Update canvas stats counter
			const _origRender = window.renderWorkspace;
			document.addEventListener('DOMContentLoaded', () => {
				const statsEl = document.getElementById('canvas-stats');
				const observer = new MutationObserver(() => {
					const count = document.querySelectorAll('.workspace-node').length;
					statsEl.textContent = count === 0 ? '0 nodes' : `${count} node${count > 1 ? 's' : ''}`;
				});
				observer.observe(document.getElementById('workspace'), { childList: true });

				// Clear output button
				document.getElementById('clear-output').addEventListener('click', () => {
					const out = document.getElementById('workflow-output');
					const status = document.getElementById('save-status');
					out.innerHTML = `<div class="output-placeholder"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="5,3 19,12 5,21"/></svg><span>Run workflow to see results</span></div>`;
					out.className = 'workflow-output';
					status.textContent = '';
					status.className = 'save-status';
				});
			});
		</script>
	</body>
</html>